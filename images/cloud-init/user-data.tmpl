#cloud-config
# Node image customisation. Placeholders __K8S_MINOR__ and
# __K8S_REPO__ are substituted by build-template.sh.
hostname: k8s-node-template
manage_etc_hosts: true

users:
  - name: kube
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys: []

package_update: true
package_upgrade: false

packages:
  - containerd
  - qemu-guest-agent
  - apt-transport-https
  - ca-certificates
  - curl
  - gpg
  - gnupg
  - nfs-common
  - open-iscsi
  # kubeadm preflight requires conntrack in PATH; also used by CNI.
  - conntrack

write_files:
  - path: /etc/modules-load.d/k8s.conf
    content: |
      overlay
      br_netfilter
  - path: /etc/sysctl.d/99-k8s.conf
    content: |
      net.bridge.bridge-nf-call-iptables = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward = 1
  - path: /etc/containerd/config.toml
    content: |
      version = 2
      [plugins."io.containerd.grpc.v1.cri"]
        sandbox_image = "registry.k8s.io/pause:3.10"
      [plugins."io.containerd.grpc.v1.cri".containerd]
        default_runtime_name = "runc"
      [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc]
        runtime_type = "io.containerd.runc.v2"
      [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc.options]
        SystemdCgroup = true

runcmd:
  # Immutable appliances: nodes are replaced, never apt-upgraded,
  # so the daily apt machinery only wastes CPU/IO and must be off.
  - systemctl disable --now apt-daily.timer apt-daily-upgrade.timer || true
  - systemctl mask apt-daily.service apt-daily-upgrade.service || true
  - modprobe overlay br_netfilter
  - sysctl --system
  - systemctl enable --now containerd qemu-guest-agent open-iscsi iscsid
  # Kubernetes packages, pinned to the minor line and held.
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL __K8S_REPO__Release.key | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
  - echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] __K8S_REPO__ /" > /etc/apt/sources.list.d/kubernetes.list
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y kubelet kubeadm kubectl
  - apt-mark hold kubelet kubeadm kubectl
  - kubeadm config images pull
  # Nodes are appliances: no SSH server in the template.
  - systemctl disable --now ssh || true
  - DEBIAN_FRONTEND=noninteractive apt-get purge -y openssh-server
  - apt-get clean
  - truncate -s 0 /etc/machine-id
  # Build report consumed by build-template.sh for verification.
  - |
    {
      echo "kubeadm: $(kubeadm version -o short 2>/dev/null || echo MISSING)"
      echo "kubelet: $(kubelet --version 2>/dev/null || echo MISSING)"
      echo "containerd: $(containerd --version 2>/dev/null || echo MISSING)"
      echo "conntrack: $(conntrack --version 2>/dev/null || echo MISSING)"
      echo "agent: $(dpkg-query -W -f='${Version}' qemu-guest-agent 2>/dev/null || echo MISSING)"
      echo "ssh-listener: $(ss -tln | grep -c ':22 ' || true)"
    } > /var/log/k8s-image-report.txt
  - cloud-init clean --logs
