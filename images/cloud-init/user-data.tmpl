#cloud-config
# Node image customisation. Placeholders __K8S_MINOR__ and
# __K8S_REPO__ are substituted by build-template.sh.
hostname: k8s-node-template
manage_etc_hosts: true

users:
  - name: kube
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys: []

package_update: true
package_upgrade: false

packages:
  - qemu-guest-agent
  - apt-transport-https
  - ca-certificates
  - curl
  - gpg
  - gnupg
  - nfs-common
  - open-iscsi
  # kubeadm preflight requires conntrack in PATH; also used by CNI.
  - conntrack
  # socat backs the vsock API proxy (hypervisor channel).
  - socat

write_files:
  - path: /etc/modules-load.d/k8s.conf
    content: |
      overlay
      br_netfilter
  - path: /etc/sysctl.d/99-k8s.conf
    content: |
      net.bridge.bridge-nf-call-iptables = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward = 1
  # Management channel: the PVE host reaches the apiserver
  # over virtio-vsock (no IP route into the node zone).
  # Harmless on workers: nothing connects without a
  # vsock device, which only control planes receive.
  - path: /etc/systemd/system/k8s-api-vsock.service
    content: |
      [Unit]
      Description=K8s API vsock proxy
      After=network.target

      [Service]
      ExecStart=/usr/bin/socat VSOCK-LISTEN:10244,reuseaddr,fork TCP:127.0.0.1:6443
      Restart=always

      [Install]
      WantedBy=multi-user.target

runcmd:
  # Immutable appliances: nodes are replaced, never apt-upgraded,
  # so the daily apt machinery only wastes CPU/IO and must be off.
  - systemctl disable --now apt-daily.timer apt-daily-upgrade.timer || true
  - systemctl mask apt-daily.service apt-daily-upgrade.service || true
  - modprobe overlay br_netfilter
  - sysctl --system
  # containerd 2.x from Docker's signed apt repo (Debian 13 ships
  # 1.7, which is end of life; Kubernetes needs the CRI RuntimeConfig
  # method and Spegel needs 2.2+). Its package carries runc.
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian trixie stable" > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y 'containerd.io=2.*'
  - apt-mark hold containerd.io
  # Start from the version's own defaults, change only what we need
  # (never a bare `bin_dir`: the image-verifier plugin has one too):
  # systemd cgroups, Cilium's CNI dir, Spegel's registry mirrors and
  # unpacked layers kept so a node can serve what it has pulled.
  - |
    containerd config default > /etc/containerd/config.toml
    sed -i "s|SystemdCgroup = .*|SystemdCgroup = true|; s|discard_unpacked_layers = .*|discard_unpacked_layers = false|; s|^\( *config_path = \).*|\1'/etc/containerd/certs.d'|; s|^\( *bin_dirs = \).*|\1['/opt/cni/bin']|" /etc/containerd/config.toml
  - systemctl enable --now containerd qemu-guest-agent open-iscsi iscsid
  - systemctl enable --now k8s-api-vsock || true
  # Kubernetes packages, pinned to the minor line and held.
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL __K8S_REPO__Release.key | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
  - echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] __K8S_REPO__ /" > /etc/apt/sources.list.d/kubernetes.list
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y kubelet kubeadm kubectl
  - apt-mark hold kubelet kubeadm kubectl
  # the sandbox (pause) image kubeadm expects, so nothing is pulled at runtime
  - |
    PAUSE=$(kubeadm config images list 2>/dev/null | grep '/pause:' | head -1)
    sed -i "s|^\( *sandbox = \).*|\1'$PAUSE'|" /etc/containerd/config.toml
    systemctl restart containerd
  - kubeadm config images pull
  # Nodes are appliances: no SSH server in the template.
  - systemctl disable --now ssh || true
  - DEBIAN_FRONTEND=noninteractive apt-get purge -y openssh-server
  - apt-get clean
  - truncate -s 0 /etc/machine-id
  # Build report consumed by build-template.sh for verification.
  - |
    {
      echo "kubeadm: $(kubeadm version -o short 2>/dev/null || echo MISSING)"
      echo "kubelet: $(kubelet --version 2>/dev/null || echo MISSING)"
      echo "containerd: $(containerd --version 2>/dev/null || echo MISSING)"
      echo "cri-config: $(grep -cE "SystemdCgroup = true|config_path = '/etc/containerd/certs.d'|/opt/cni/bin|discard_unpacked_layers = false" /etc/containerd/config.toml)"
      echo "conntrack: $(conntrack --version 2>/dev/null || echo MISSING)"
      echo "agent: $(dpkg-query -W -f='${Version}' qemu-guest-agent 2>/dev/null || echo MISSING)"
      echo "ssh-listener: $(ss -tln | grep -c ':22 ' || true)"
    } > /var/log/k8s-image-report.txt
  - cloud-init clean --logs
