# Shared build inputs for all node images. Per-Kubernetes-version
# pins live in versions/<minor>.env (K8S_MINOR, K8S_REPO,
# repo pins only); build-template.sh requires --k8s-version. The image
# revision is NOT pinned anywhere: see revision.sh.
# Debian 13 (trixie) since the P13 template rebuild: the
# Debian 12 6.1 kernel rejects CephX keys from current
# Ceph ("libceph: secret too big") and cannot mount CephFS.
DEBIAN_IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2
DEBIAN_IMAGE_NAME=debian-13-genericcloud-amd64.qcow2
DEBIAN_IMAGE_URL_ARM64=https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-arm64.qcow2
DEBIAN_IMAGE_NAME_ARM64=debian-13-genericcloud-arm64.qcow2
TEMPLATE_MEMORY=4096
TEMPLATE_CORES=2
TEMPLATE_DISK=20G
