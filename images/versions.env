# Shared build inputs for all node images. Per-Kubernetes-version
# pins live in versions/<minor>.env (K8S_MINOR, K8S_REPO,
# IMAGE_REVISION); build-template.sh requires --k8s-version.
DEBIAN_IMAGE_URL=https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2
DEBIAN_IMAGE_NAME=debian-12-genericcloud-amd64.qcow2
TEMPLATE_MEMORY=4096
TEMPLATE_CORES=2
TEMPLATE_DISK=20G
